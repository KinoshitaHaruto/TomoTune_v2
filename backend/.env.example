# Render の Environment Variables に設定する

# Supabase の接続文字列（Project Settings > Database > Connection string > URI）
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Spotify Developer Dashboard で取得
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Render のバックエンドURL + /api/spotify/callback
SPOTIFY_REDIRECT_URI=https://tomotune-backend.onrender.com/api/spotify/callback

# Vercel にデプロイしたフロントエンドのURL
FRONTEND_URL=https://tomo-tune.vercel.app

# CORS: フロントエンドのURL（複数ある場合はカンマ区切り）
ALLOWED_ORIGINS=https://tomo-tune.vercel.app
